# App-on-host scenario: infra (postgres, redis, minio) runs in Docker; API and worker run on the host.
# Copy to .env and fill in secrets. Use this when you run: scripts/up-infra.ps1 then uvicorn/arq on the host.
# Host must use localhost to reach Docker-published ports.

# --- Required ---
ENVIRONMENT=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=app

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (host talks to MinIO at localhost:9000) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=flow-graph
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Worker ---
WORKER_CONCURRENCY=1

# --- LLM (set your key or leave unset for fake LLM) ---
# LITELLM_API_KEY=
LITELLM_MODEL=gemini/gemini-3.1-flash-lite-preview
# LITELLM_EXTRACTION_DELAY_SECONDS=5.0
# LITELLM_REQUEST_TIMEOUT=120

# --- Optional ---
# USE_FAKE_ADAPTERS=1
