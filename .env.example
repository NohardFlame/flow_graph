# Copy this file to .env and fill in your values.
# Do not commit .env (it is in .gitignore).

# --- Required ---
ENVIRONMENT=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app

# --- Queue (required for API + worker with real queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Optional: use in-memory storage/queue (no S3/Redis) ---
# USE_FAKE_ADAPTERS=1

# --- API ---
# API_HOST=0.0.0.0
# API_PORT=8000

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=flow-graph
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Worker ---
# WORKER_CONCURRENCY=2
# WORKER_QUEUE_NAME=default
# WORKER_JOB_TIMEOUT_SECONDS=900

# --- LLM (required for real extraction; unset = fake LLM) ---
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL=gpt-4o-mini
# LITELLM_BASE_URL=
# LITELLM_EXTRACTION_DELAY_SECONDS=2.0
# LITELLM_REQUEST_TIMEOUT=120

# --- Vertex AI: use GOOGLE_APPLICATION_CREDENTIALS or gcloud auth; do not set LITELLM_API_KEY ---
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# LITELLM_MODEL=vertex_ai/gemini-1.5-flash-001

# --- Optional features ---
# ENABLE_QDRANT=0
# ENABLE_LLM_CACHE=0
# QDRANT_ENABLED=0
# QDRANT_URL=http://localhost:6333
